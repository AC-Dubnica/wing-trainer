{
  "name": "wing-trainer",
  "version": "0.1.0",
  "private": true,
  "description": "A practice console for a Behringer WING setup: load a snapshot and a recording, and try the mix.",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && node scripts/e2e-engine.mjs && node scripts/e2e-session.mjs",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "author": "AC Dubnica",
  "homepage": "https://github.com/AC-Dubnica/wing-trainer",
  "build": {
    "appId": "sk.acdubnica.wingtrainer",
    "productName": "WING Trainer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "identity": null,
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage"
        },
        {
          "target": "deb"
        }
      ],
      "category": "AudioVideo",
      "maintainer": "AC Dubnica <noreply@github.com>",
      "synopsis": "A practice console for a Behringer WING setup",
      "icon": "build/icon.png",
      "executableName": "wing-trainer"
    },
    "npmRebuild": false
  }
}
